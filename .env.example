# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================================================
# 
# IMPORTANTE: 
# 1. Copia este archivo como ".env" en la raíz del proyecto
# 2. Completa los valores con tus credenciales reales
# 3. NUNCA commitees el archivo .env al repositorio
# 4. El archivo .env está incluido en .gitignore por seguridad
#
# ============================================================================

# Servidor SQL Server
# Ejemplo: 10.101.2.181 o localhost o nombre-servidor.dominio.com
DB_SERVER=10.101.2.181

# Nombre de la base de datos
# Ejemplo: SAP_G02E05_Innoprint
DB_NAME=SAP_G02E05_Innoprint

# Usuario de la base de datos
# Ejemplo: ReportesInnoprint
DB_USERNAME=tu_usuario_aqui

# Contraseña del usuario
# IMPORTANTE: Mantener esta contraseña segura y privada
DB_PASSWORD=tu_password_aqui

# Driver ODBC (opcional - por defecto usa "ODBC Driver 17 for SQL Server")
# DB_DRIVER=ODBC Driver 17 for SQL Server

# Timeout de conexión en segundos (opcional - por defecto 30)
# DB_TIMEOUT=30

# ============================================================================
# CONFIGURACIÓN DE SALIDA
# ============================================================================

# Ruta de salida para archivos generados (opcional)
# Si no se especifica, usa la ruta determinada automáticamente por el script
# OUTPUT_PATH=C:\MisReportes

# Nombre del archivo de salida (opcional - por defecto "tablas_unificadas.xlsx")
# OUTPUT_FILENAME=tablas_unificadas.xlsx

# ============================================================================
# CONFIGURACIÓN DE LOGGING (FUTURO)
# ============================================================================

# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Ruta del archivo de log (opcional)
# LOG_FILE=logs/unificacion.log

# ============================================================================
# CONFIGURACIÓN AVANZADA (FUTURO)
# ============================================================================

# Pool de conexiones SQL
# POOL_SIZE=5
# MAX_OVERFLOW=10
# POOL_RECYCLE=3600

# Cache de resultados
# ENABLE_CACHE=true
# CACHE_TIMEOUT=3600

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================
#
# ✅ HACER:
# - Usar contraseñas fuertes (mínimo 12 caracteres)
# - Cambiar contraseñas regularmente
# - Usar usuarios con permisos mínimos necesarios
# - Mantener .env fuera del control de versiones
# - Hacer backup del .env de forma segura
#
# ❌ NO HACER:
# - Compartir credenciales por email o chat
# - Usar la misma contraseña en múltiples sistemas
# - Commitear .env al repositorio
# - Dejar credenciales en código fuente
# - Usar contraseñas débiles o predecibles
#
# ============================================================================
